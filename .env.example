# Интеграция маркировки «Честный знак» × МойСклад (Cosmex)
# Скопируйте в .env и заполните. Файл .env в git не попадает.

# ---------- Безопасность ----------
# true (по умолчанию): записывающие операции только логируются, ничего не отправляется.
# Переключайте в false только после проверки отчётов в reports/.
DRY_RUN=true

# ---------- МойСклад ----------
# Токен: Настройки → Обмен данными → Токены (или POST /security/token).
# ВНИМАНИЕ: логин/пароль работает, но с 01.09.2026 его лимит API падает до 15 запросов/3с,
# с 01.12.2026 — до 11/3с. Долгосрочно нужен токен приватного решения (Vendor API).
MOYSKLAD_TOKEN=
# Запасной вариант вместо токена:
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=

# ---------- Честный знак (ГИС МТ) ----------
# true = песочница (markirovka.sandbox.crptech.ru), false = продуктив.
CRPT_SANDBOX=true
# ИНН участника оборота (юрлицо/ИП, на которое зарегистрирован ЛК ЧЗ).
CRPT_INN=
# Команда внешнего подписанта УКЭП (КриптоПро). Пример:
# CRPT_SIGNER_CMD="/opt/cprocsp/bin/amd64/cryptcp -signf -thumbprint {thumbprint} -der -strict -cert -detached=no -pipe"
CRPT_SIGNER_CMD=
# Отпечаток (thumbprint) сертификата УКЭП.
CRPT_CERT_THUMBPRINT=

# ---------- СУЗ (заказ кодов напрямую, без МойСклад) ----------
# ЛК ЧЗ → Управление заказами → Устройства.
CRPT_OMS_ID=
CRPT_OMS_TOKEN=

# ---------- Уведомления ----------
# Телеграм-бот (@BotFather) и чат менеджеров.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Сервер (вебхуки + панель) ----------
PORT=8787
# Секрет в URL вебхуков (?secret=...), чтобы чужие запросы отбрасывались.
WEBHOOK_SECRET=
