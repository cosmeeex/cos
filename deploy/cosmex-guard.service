[Unit]
Description=Cosmex — страж маркировки (Честный знак × МойСклад)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cosmex-chestny-znak
ExecStart=/usr/bin/node src/server.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Секреты — в /opt/cosmex-chestny-znak/.env (читается приложением)
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/cosmex-chestny-znak/data /opt/cosmex-chestny-znak/reports

[Install]
WantedBy=multi-user.target
